# ==========================================
# VietTeach - Git Ignore Configuration
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# --- IDEs & Editors ---
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm...)
.idea/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo

# --- Logs & Temp Files ---
*.log
*.tmp
*.bak
temp/
tmp/

# --- Web & Node.js (dành cho các công cụ mở rộng tương lai) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# CHÚ Ý: KHÔNG BỎ QUA FILE TEST CỦA ĐỀ THI
# Các file *.inp, *.out, *.ans trong practice/de-thi là bộ test bắt buộc cần giữ
# ==========================================
!practice/**/*.inp
!practice/**/*.out
!practice/**/*.ans
!practice/**/*.in
